# Personal Finance Tracker Environment Configuration

# Database Connection URL (Defaults to local SQLite database)
DATABASE_URL=sqlite:///./finance.db

# Server Port Binding (Defaults to 8000)
PORT=8000

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional API Key for REST API Endpoints (Leave blank for local unauthenticated dev mode)
API_KEY=
